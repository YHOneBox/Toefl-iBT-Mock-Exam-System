DATABASE_URL="file:../data/toefl.db"

# Optional. Comma-separated origins allowed to load the Next.js dev client (VPN IP).
# Example: ALLOWED_ORIGINS=http://100.x.y.z:3000
ALLOWED_ORIGINS=

# Primary: Gemini chain (scan and order models in /settings). Last fallback: OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL="gemini-2.5-flash-lite"

OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_TTS_VOICE="nova"
OPENAI_TTS_VOICE_US_FEMALE="nova"
OPENAI_TTS_VOICE_US_MALE="onyx"
OPENAI_TTS_VOICE_UK_FEMALE="fable"
OPENAI_TTS_VOICE_UK_MALE="echo"
OPENAI_TTS_VOICE_AU_FEMALE="shimmer"
OPENAI_TTS_VOICE_AU_MALE="verse"
OPENAI_WHISPER_MODEL="whisper-1"

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_US=
ELEVENLABS_VOICE_UK=
ELEVENLABS_VOICE_AU=
ELEVENLABS_VOICE_US_FEMALE=
ELEVENLABS_VOICE_US_MALE=
ELEVENLABS_VOICE_UK_FEMALE=
ELEVENLABS_VOICE_UK_MALE=
ELEVENLABS_VOICE_AU_FEMALE=
ELEVENLABS_VOICE_AU_MALE=
